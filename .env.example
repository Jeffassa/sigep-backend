# =====================================================================
# Variables d'environnement SIGEP Backend — PRODUCTION
# Copier en .env (NE JAMAIS committer .env) et renseigner des valeurs fortes.
# =====================================================================

# --- Base de données PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/sigep_db
DB_USERNAME=postgres
DB_PASSWORD=                # OBLIGATOIRE — mot de passe fort

# --- JWT (générer des clés base64 d'au moins 256 bits, DISTINCTES) ---
# Exemple de génération : openssl rand -base64 48
JWT_SECRET=                 # OBLIGATOIRE
JWT_QR_SECRET=             # OBLIGATOIRE — différent de JWT_SECRET
JWT_EXPIRATION=86400000     # durée de validité du token (ms), optionnel

# --- Compte administrateur initial ---
ADMIN_EMAIL=admin@esatic.ci
ADMIN_PASSWORD=             # si vide : mot de passe aléatoire généré et affiché 1 fois dans les logs

# --- JPA / Hibernate ---
JPA_DDL_AUTO=validate       # 'validate' ou 'none' en prod (jamais 'update')
JPA_SHOW_SQL=false

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=https://admin.exemple.ci

# --- Sécurité ---
# Mettre à true UNIQUEMENT si l'app est derrière un reverse proxy de confiance
# qui positionne X-Forwarded-For (sinon le rate-limiting est contournable).
TRUST_FORWARDED_FOR=false
