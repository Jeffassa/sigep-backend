# ─────────────────────────────────────────────────────────────────────────────
# Gabarit des secrets pour docker-compose (profil "docker").
#
# UTILISATION :
#   cp .env.docker.example .env
#   puis remplacer chaque valeur ci-dessous par une valeur PROPRE à votre environnement.
#
# docker-compose charge automatiquement le fichier .env (non versionné, cf .gitignore)
# pour interpoler ${VAR} dans docker-compose.yml.
#
# NE JAMAIS committer le fichier .env rempli. Ne jamais réutiliser ces valeurs en production.
# ─────────────────────────────────────────────────────────────────────────────

# Mot de passe PostgreSQL (partagé par le conteneur postgres et l'application).
DB_PASSWORD=change_me_mot_de_passe_fort

# Clés JWT — OBLIGATOIRES, distinctes, min. 256 bits, encodées en base64.
# Générer deux clés distinctes, par exemple :
#   openssl rand -base64 48
JWT_SECRET=REMPLACER_par_openssl_rand_base64_48
JWT_QR_SECRET=REMPLACER_par_une_AUTRE_openssl_rand_base64_48

# (Optionnel) surcharges non sensibles
# DB_NAME=sigep_db
# DB_USER=sigep_user
