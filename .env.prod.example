# =====================================================================
# Variables d'environnement de PRODUCTION (à copier en .env.prod et remplir).
# NE JAMAIS committer le .env.prod rempli. Générer des secrets forts et uniques.
#   Générer une clé : openssl rand -base64 48
# =====================================================================

# --- Domaine (pour nginx / TLS) ---
DOMAIN=sigep.exemple.ci
LETSENCRYPT_EMAIL=admin@exemple.ci

# --- Base de données ---
DB_NAME=sigep_db
DB_USERNAME=sigep
DB_PASSWORD=                 # OBLIGATOIRE — mot de passe fort

# --- JWT (clés base64 ≥ 256 bits, DISTINCTES) ---
JWT_SECRET=                  # OBLIGATOIRE
JWT_QR_SECRET=               # OBLIGATOIRE — différent de JWT_SECRET
# Durées optionnelles (défauts : access 15 min, refresh 30 j)
# JWT_EXPIRATION=900000
# JWT_REFRESH_EXPIRATION=2592000000

# --- Compte administrateur initial ---
ADMIN_EMAIL=admin@esatic.ci
ADMIN_PASSWORD=              # si vide : mot de passe aléatoire généré et affiché 1 fois dans les logs

# --- Sécurité (valeurs prod) ---
APP_SECURITY_REQUIRE_HTTPS=true
TRUST_FORWARDED_FOR=true     # vrai car derrière nginx
# CORS : origines autorisées (séparées par des virgules). Pour l'app mobile seule, peut rester vide.
CORS_ALLOWED_ORIGINS=https://sigep.exemple.ci

# --- E-mail (notifications) ---
MAIL_ENABLED=false           # true + SMTP ci-dessous pour activer les notifications
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@esatic.ci

# --- Rapports PDF (volume persistant dans le conteneur) ---
RAPPORTS_DOSSIER=/data/rapports
